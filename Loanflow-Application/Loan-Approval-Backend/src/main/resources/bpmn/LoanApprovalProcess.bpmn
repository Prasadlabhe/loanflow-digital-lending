        <zeebe:taskDefinition type="process-review-result" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03d0wlw</bpmn:incoming>
      <bpmn:outgoing>Flow_0q3jgjy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0q3jgjy" sourceRef="Activity_1ulpek0" targetRef="Gateway_0o46vzc" />
  </bpmn:process>
