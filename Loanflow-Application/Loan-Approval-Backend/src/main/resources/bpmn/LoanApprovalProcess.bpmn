  <bpmn:collaboration id="Collaboration_1moge23">
    <bpmn:participant id="Participant_1fylr85" name="Loan Approval Process" processRef="LoanApprovalProcess" />
  </bpmn:collaboration>
  <bpmn:process id="LoanApprovalProcess" name="LoanApprovalProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1cj9qgf</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_1mfc3zu" name="Validate Loan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-loan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1cj9qgf</bpmn:incoming>
      <bpmn:outgoing>Flow_1ge8gnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1cj9qgf" sourceRef="StartEvent_1" targetRef="Activity_1mfc3zu" />
    <bpmn:sequenceFlow id="Flow_1ge8gnd" sourceRef="Activity_1mfc3zu" targetRef="LoanDecision" />
    <bpmn:sequenceFlow id="Flow_0ehwxrk" sourceRef="Activity_0zq4ut5" targetRef="Event_0lmf80t" />
    <bpmn:endEvent id="Event_0lmf80t" name="Approved">
      <bpmn:incoming>Flow_0ehwxrk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_100626c" sourceRef="LoanDecision" targetRef="Gateway_0d13o2y" />
    <bpmn:businessRuleTask id="LoanDecision" name="Loan Decision">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="LoanDecision" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ge8gnd</bpmn:incoming>
      <bpmn:outgoing>Flow_100626c</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_0d13o2y" name="Decision?">
      <bpmn:incoming>Flow_100626c</bpmn:incoming>
      <bpmn:outgoing>Flow_06lbalb</bpmn:outgoing>
      <bpmn:outgoing>Flow_0wsctnw</bpmn:outgoing>
      <bpmn:outgoing>Flow_1frfj1k</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_06lbalb" name="Approve" sourceRef="Gateway_0d13o2y" targetRef="Activity_0zq4ut5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0wsctnw" name="Review" sourceRef="Gateway_0d13o2y" targetRef="Activity_1dvu3yp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1frfj1k" name="Reject" sourceRef="Gateway_0d13o2y" targetRef="Activity_1avmgzq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "REJECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1avmgzq" name="Reject Loan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-loan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1frfj1k</bpmn:incoming>
      <bpmn:outgoing>Flow_05mpger</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0zq4ut5" name="Approve Loan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="approve-loan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06lbalb</bpmn:incoming>
      <bpmn:outgoing>Flow_0ehwxrk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0o46vzc" name="Review Decision?">
      <bpmn:incoming>Flow_0q3jgjy</bpmn:incoming>
      <bpmn:outgoing>Flow_0u6v66w</bpmn:outgoing>
      <bpmn:outgoing>Flow_06oz2xv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_03d0wlw" sourceRef="Activity_1dvu3yp" targetRef="Activity_1ulpek0" />
    <bpmn:sequenceFlow id="Flow_0u6v66w" name="Approve" sourceRef="Gateway_0o46vzc" targetRef="Event_0entpd1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06oz2xv" name="Reject" sourceRef="Gateway_0o46vzc" targetRef="Event_12ybf0x">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05mpger" sourceRef="Activity_1avmgzq" targetRef="Event_16rtkmm" />
    <bpmn:endEvent id="Event_16rtkmm" name="Rejected">
      <bpmn:incoming>Flow_05mpger</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0entpd1" name="Approved">
      <bpmn:incoming>Flow_0u6v66w</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_12ybf0x" name="Rejected">
      <bpmn:incoming>Flow_06oz2xv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_1dvu3yp" name="Manual Loan Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="loan-review-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wsctnw</bpmn:incoming>
      <bpmn:outgoing>Flow_03d0wlw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_1ulpek0" name="Process Review Result">
